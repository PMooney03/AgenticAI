# Copy to .env and adjust. Never commit .env.

# --- Ollama (local LLM inference) ---
# When the backend runs on the host:
OLLAMA_BASE_URL=http://localhost:11434
# When the backend runs inside Docker and Ollama runs on the host (Phase 8):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_SECONDS=120

# --- Embeddings (served by Ollama; `ollama pull nomic-embed-text`) ---
EMBEDDING_MODEL=nomic-embed-text

# --- Qdrant (docker compose up -d qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- Ingestion / retrieval ---
MAX_UPLOAD_MB=20
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K=4

# --- Agent (LangGraph step budget: plan nodes before a forced answer) ---
AGENT_MAX_STEPS=3
# MCP tools run in-process by default (real protocol, no subprocess).
# Standalone stdio server:  cd backend && uv run python -m app.mcp
# save_note writes to data/notes.jsonl after human approval.

# --- Application ---
APP_NAME=Agentic Second Brain
LOG_LEVEL=INFO
# Comma-separated origins for the React UI (Vite default port is 5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
